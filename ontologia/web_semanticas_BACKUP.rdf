<owl:Class rdf:about="#Dueño">
  <rdfs:subClassOf rdf:resource="#Entidad_Externa"/>
  <rdfs:label xml:lang="es">Dueño</rdfs:label>
  <rdfs:label xml:lang="en">Owner</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Electrodomestico">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#fabricado_por"/>
      <owl:someValuesFrom rdf:resource="#Marca"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label xml:lang="es">Electrodoméstico</rdfs:label>
  <rdfs:label xml:lang="en">Home Appliance</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Marca">
  <rdfs:subClassOf rdf:resource="#Entidad_Externa"/>
  <rdfs:label xml:lang="en">Brand</rdfs:label>
  <rdfs:label xml:lang="es">Marca</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Componente_Fisico">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#fabricado_por"/>
      <owl:someValuesFrom rdf:resource="#Marca"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label xml:lang="es">Componente Físico</rdfs:label>
  <rdfs:label xml:lang="en">Physical Component</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#De_Limpieza">
  <rdfs:subClassOf rdf:resource="#Electrodomestico"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#garantia_extendida"/>
      <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</owl:hasValue>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label xml:lang="en">Cleaning Appliance</rdfs:label>
  <rdfs:label xml:lang="es">De Limpieza</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Computadora">
  <rdfs:subClassOf rdf:resource="#De_Multimedia"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#tiene_componente"/>
      <owl:someValuesFrom rdf:resource="#Pantalla"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#De_Climatizacion">
  <rdfs:subClassOf rdf:resource="#Electrodomestico"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#garantia_extendida"/>
      <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</owl:hasValue>
