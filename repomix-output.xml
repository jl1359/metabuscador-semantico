async function doDbpSearch() {
    const input = document.getElementById('searchInput').value; // Asegúrate que sea el ID de tu barra
    const contenedorLocal = document.getElementById('contenedorResultadosLocales'); // Div para resultados locales
    const contenedorDbpedia = document.getElementById('contenedorResultadosDbpedia'); // Div para resultados remotos
    
    if(!input.trim()) return;

    // Indicadores de carga visuales
    contenedorLocal.innerHTML = '<p>Buscando localmente... ⏳</p>';
    contenedorDbpedia.innerHTML = '<p>Conectando con DBpedia... ⏳</p>';

    try {
        // Ejecución Concurrente: Dispara ambas búsquedas al mismo tiempo
        const [respuestaLocal, respuestaDbpedia] = await Promise.all([
            fetch(`${API}/buscar?term=${encodeURIComponent(input)}`),
            fetch(`${API}/dbpedia?term=${encodeURIComponent(input)}`)
        ]);

        const datosLocal = await respuestaLocal.json();
        const datosDbpedia = await respuestaDbpedia.json();

        // Limpiar contenedores
        contenedorLocal.innerHTML = `<h3>🏠 Resultados Locales (${datosLocal.resultados.length})</h3>`;
        contenedorDbpedia.innerHTML = `<h3>🌐 Resultados en DBpedia (${datosDbpedia.resultados.length})</h3>`;

        // Renderizar Local (Reemplaza con el nombre de tu función de dibujado local)
        if(datosLocal.resultados.length > 0) {
            contenedorLocal.innerHTML += generarTarjetasLocales(datosLocal.resultados);
        } else {
            contenedorLocal.innerHTML += '<p>No se encontraron registros en tu ontología.</p>';
        }

        // Renderizar DBpedia (Reemplaza con el nombre de tu función de dibujado de DBpedia)
        if(datosDbpedia.resultados.length > 0) {
            contenedorDbpedia.innerHTML += generarTarjetasDbpedia(datosDbpedia.resultados);
        } else {
            contenedorDbpedia.innerHTML += '<p>No se encontraron registros externos.</p>';
        }

    } catch (error) {
        alert("Error en la búsqueda federada: " + error.message);
    }
}

